datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  ADMIN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SEEDS
  FERTILIZER
  PESTICIDE
  FUEL
  LABOR
  EQUIPMENT
  OTHER
}

enum TaskType {
  PLANTING      // Φύτευση / Σπορά
  FERTILIZATION // Λίπανση
  SPRAYING      // Ψεκασμός
  HARVEST       // Συγκομιδή
  SHREDDING     // Καταστροφέας
}

enum HarvestQualityGrade {
  GRADE_A       // Κατηγορία Α
  GRADE_B       // Κατηγορία Β
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(FARMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fields    Field[]
  expenses  Expense[]
  customers Customer[]
}
model Customer {
  id            String         @id @default(uuid())
  name          String         // π.χ. "Αγροτικός Συνεταιρισμός", "Έμπορος Παπαδόπουλος"
  phone         String?
  vatNumber     String?        // ΑΦΜ (προαιρετικά)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  dispatches    DispatchNote[]
}

model Field {
  id            String      @id @default(uuid())
  name          String
  areaInStremma Float       // Έκταση σε στρέμματα
  location      String?     // Τοποθεσία ή συντεταγμένες
  soilType      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  cropCycles    CropCycle[]
  expenses      Expense[]
}

model CropCycle {
  id          String         @id @default(uuid())
  cropType    String         // π.χ. Ελιά, Βαμβάκι, Σιτάρι
  variety     String?        // Ποικιλία
  year        Int            @default(2026) // Έτος σεζόν
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fieldId     String
  field       Field          @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  tasks       Task[]
  expenses    Expense[]
  dispatches  DispatchNote[]
}

model Task {
  id                String               @id @default(uuid())
  taskType          TaskType             // Ο τύπος της εργασίας
  title             String?              // Προαιρετικός σύντομος τίτλος/περιγραφή
  status            TaskStatus           @default(PENDING)
  dueDate           DateTime?
  completedAt       DateTime?
  notes             String?

  // Συσχέτιση με Δελτίο Αποστολής (Batch Tracking)
  dispatchNoteId    String?
  dispatchNote      DispatchNote?        @relation(fields: [dispatchNoteId], references: [id], onDelete: SetNull)

  // Πεδία για Ψεκασμό / Λίπανση
  productName       String?              // π.χ. "NPK 20-20-20" ή "Decis Trap"
  quantityApplied   Float?               // π.χ. 25.5
  dosageUnit        String?              // π.χ. "kg", "λίτρα", "cc/στρέμμα"

  // Πεδία για Συγκομιδή
  harvestQuantityKg Float?               // Ποσότητα σε κιλά (kg)
  qualityGrade      HarvestQualityGrade? // GRADE_A ή GRADE_B

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  cropCycleId       String
  cropCycle         CropCycle            @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String          @id @default(uuid())
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Συσχέτιση με Χρήστη (Υποχρεωτική)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Προαιρετικές συσχετίσεις (για ευελιξία στην καταχώρηση)
  fieldId     String?
  field       Field?          @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  cropCycleId String?
  cropCycle   CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
}

model DispatchNote {
  id             String       @id @default(uuid())
  dispatchNumber String
  quantityKg     Float        // Ποσότητα σε kg
  deliveryDate   DateTime     @default(now())
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cropCycleId    String
  cropCycle      CropCycle    @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  settlement     Settlement?
  harvestTasks   Task[]
}

model Settlement {
  id             String           @id @default(uuid())
  totalAmount    Float            // Συνολικό ποσό εκκαθάρισης (άθροισμα όλων των γραμμών)
  totalQuantityKg Float           // Συνολικά κιλά που τιμολογήθηκαν
  settledAt      DateTime         @default(now())
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  dispatchNoteId String           @unique
  dispatchNote   DispatchNote     @relation(fields: [dispatchNoteId], references: [id], onDelete: Cascade)

  items          SettlementItem[]
}

model SettlementItem {
  id           String      @id @default(uuid())
  grade        String?     // π.χ. "Κατηγορία Α", "Διαλογή", "Βιομηχανική"
  quantityKg   Float       // Κιλά για τη συγκεκριμένη τιμή (π.χ. 80 kg)
  pricePerKg   Float       // Τιμή ανά κιλό (π.χ. 1.00 €)
  subtotal     Float       // quantityKg * pricePerKg (π.χ. 80.00 €)

  settlementId String
  settlement   Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}