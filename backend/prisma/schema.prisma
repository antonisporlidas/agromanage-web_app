datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FARMER
  ADMIN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SEEDS_PLANTS     // Σπόροι / Φυτά
  FERTILIZERS      // Λιπάσματα
  PESTICIDES       // Φυτοφάρμακα
  LABOR            // Εργατικά / Ημερομίσθια
  FUEL             // Καύσιμα / Πετρέλαιο
  IRRIGATION       // Άρδευση / Ρεύμα / Νερό
  EQUIPMENT        // Συντήρηση εξοπλισμού / Μηχανήματα
  OTHER            // Λοιπά έξοδα
}

enum TaskType {
  PLANTING      // Φύτευση / Σπορά
  FERTILIZATION // Λίπανση
  SPRAYING      // Ψεκασμός
  HARVEST       // Συγκομιδή
  SHREDDING     // Καταστροφέας
}

enum HarvestQualityGrade {
  GRADE_A       // Κατηγορία Α
  GRADE_B       // Κατηγορία Β
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(FARMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  fields    Field[]
  expenses  Expense[]
  customers Customer[]
}
model Customer {
  id            String         @id @default(uuid())
  name          String         // π.χ. "Αγροτικός Συνεταιρισμός", "Έμπορος Παπαδόπουλος"
  phone         String?
  vatNumber     String?        // ΑΦΜ (προαιρετικά)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  dispatches    DispatchNote[]
}

model Field {
  id            String      @id @default(uuid())
  name          String
  areaInStremma Float       // Έκταση σε στρέμματα
  location      String?     // Τοποθεσία ή συντεταγμένες
  soilType      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  cropCycles    CropCycle[]
  expenses      Expense[]
}

model CropCycle {
  id          String         @id @default(uuid())
  cropType    String         // π.χ. Ελιά, Βαμβάκι, Σιτάρι
  variety     String?        // Ποικιλία
  year        Int            @default(2026) // Έτος σεζόν
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  fieldId     String
  field       Field          @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  tasks       Task[]
  expenses    Expense[]
  dispatches  DispatchNote[]
  settlementItems SettlementItem[]
}

model Task {
  id                String               @id @default(uuid())
  taskType          TaskType             // Ο τύπος της εργασίας
  title             String?              // Προαιρετικός σύντομος τίτλος/περιγραφή
  status            TaskStatus           @default(PENDING)
  dueDate           DateTime?
  completedAt       DateTime?
  notes             String?

  // Συσχέτιση με Δελτίο Αποστολής (Batch Tracking)
  dispatchNoteId    String?
  dispatchNote      DispatchNote?        @relation(fields: [dispatchNoteId], references: [id], onDelete: SetNull)

  // Πεδία για Ψεκασμό / Λίπανση
  productName       String?              // π.χ. "NPK 20-20-20" ή "Decis Trap"
  quantityApplied   Float?               // π.χ. 25.5
  dosageUnit        String?              // π.χ. "kg", "λίτρα", "cc/στρέμμα"

  // Πεδία για Συγκομιδή
  harvestQuantityKg Float?               // Ποσότητα σε κιλά (kg)
  qualityGrade      HarvestQualityGrade? // GRADE_A ή GRADE_B

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  cropCycleId       String
  cropCycle         CropCycle            @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String          @id @default(uuid())
  title       String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  year        Int?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Συσχέτιση με Χρήστη (Υποχρεωτική)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Προαιρετικές συσχετίσεις (για ευελιξία στην καταχώρηση)
  fieldId     String?
  field       Field?          @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  cropCycleId String?
  cropCycle   CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)
}

enum DispatchStatus {
  PENDING             // Καμία εκκαθάριση
  PARTIALLY_SETTLED   // Μερική εκκαθάριση
  SETTLED             // Πλήρης εξόφληση/εκκαθάριση
}

model DispatchNote {
  id             String          @id @default(uuid())
  dispatchNumber String
  quantityKg     Float           // Συνολικά κιλά δελτίου
  status         DispatchStatus  @default(PENDING)
  deliveryDate   DateTime        @default(now())
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)

  cropCycleId    String?
  cropCycle      CropCycle?      @relation(fields: [cropCycleId], references: [id], onDelete: SetNull)

  // Αλλαγή από Settlement? σε Settlement[] (Σχέση 1 προς Πολλά)
  settlements    Settlement[]
  harvestTasks   Task[]
}

model Settlement {
  id              String           @id @default(uuid())
  totalAmount     Float            @default(0.0)
  totalQuantityKg Float            @default(0.0)
  settledAt       DateTime         @default(now())
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  dispatchNoteId  String
  // Αφαιρέθηκε το @unique από το dispatchNoteId για να επιτρέπονται πολλαπλές εκκαθαρίσεις
  dispatchNote    DispatchNote     @relation(fields: [dispatchNoteId], references: [id], onDelete: Cascade)

  items           SettlementItem[]
}

model SettlementItem {
  id           String      @id @default(uuid())
  grade        String?     // π.χ. "Α Διαλογή", "Βιομηχανική"
  quantityKg   Float       // Κιλά (π.χ. 30 kg)
  pricePerKg   Float       // Τιμή ανά κιλό (π.χ. 1.00 €)
  subtotal     Float       // quantityKg * pricePerKg

  settlementId String
  settlement   Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  // Βάλε ? για να είναι nullable και να περάσει άμεσα
  cropCycleId  String?
  cropCycle    CropCycle?  @relation(fields: [cropCycleId], references: [id], onDelete: Restrict)
}